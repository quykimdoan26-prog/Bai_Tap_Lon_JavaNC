<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.ucop.desktop.ui.CustomerController">
    <top><ToolBar>
        <Label fx:id="welcomeLabel" text="UCOP SHOP" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Đăng xuất" onAction="#logout"/>
    </ToolBar></top>
    <center><TabPane tabClosingPolicy="UNAVAILABLE">
        <Tab text="Trang chủ">
            <BorderPane style="-fx-padding: 14;">
                <top><Label text="Sản phẩm công nghệ" style="-fx-font-size: 20px; -fx-font-weight: bold;"/></top>
                <center><TableView fx:id="productTable">
                    <columns>
                        <TableColumn fx:id="productSkuColumn" text="SKU" prefWidth="140"/>
                        <TableColumn fx:id="productNameColumn" text="Tên sản phẩm" prefWidth="320"/>
                        <TableColumn fx:id="productPriceColumn" text="Giá bán" prefWidth="160"/>
                    </columns>
                </TableView></center>
                <bottom><HBox spacing="8" style="-fx-padding: 10 0 0 0;">
                    <TextField fx:id="quantityField" promptText="Số lượng" prefWidth="100"/>
                    <Button text="Thêm vào giỏ" onAction="#addToCart"/>
                </HBox></bottom>
            </BorderPane>
        </Tab>
        <Tab text="Giỏ hàng &amp; thanh toán">
            <VBox spacing="8" style="-fx-padding: 14;">
                <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="cartSkuColumn" text="SKU" prefWidth="120"/>
                        <TableColumn fx:id="cartNameColumn" text="Sản phẩm" prefWidth="300"/>
                        <TableColumn fx:id="cartQuantityColumn" text="SL" prefWidth="80"/>
                        <TableColumn fx:id="cartTotalColumn" text="Thành tiền" prefWidth="150"/>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <Button text="Xóa dòng chọn" onAction="#removeFromCart"/>
                    <TextField fx:id="promotionField" promptText="Mã giảm giá" prefWidth="180"/>
                    <ComboBox fx:id="paymentMethodBox" promptText="Thanh toán" prefWidth="180"/>
                    <Label fx:id="totalLabel" text="Tạm tính: 0 VND"/>
                    <Button text="ĐẶT HÀNG" onAction="#checkout"/>
                </HBox>
                <Label fx:id="messageLabel" wrapText="true"/>
            </VBox>
        </Tab>
        <Tab text="Đơn hàng của tôi">
            <VBox spacing="8" style="-fx-padding: 14;">
                <Button text="Làm mới" onAction="#refreshOrders" maxWidth="100"/>
                <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="orderIdColumn" text="Mã đơn" prefWidth="100"/>
                        <TableColumn fx:id="orderStatusColumn" text="Trạng thái" prefWidth="200"/>
                        <TableColumn fx:id="orderTotalColumn" text="Tổng tiền" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        <Tab text="Thông tin cá nhân">
            <VBox spacing="10" style="-fx-padding: 24; -fx-max-width: 500;">
                <TextField fx:id="fullNameField" promptText="Họ và tên"/>
                <TextField fx:id="emailField" promptText="Email"/>
                <TextField fx:id="phoneField" promptText="Số điện thoại"/>
                <Button text="Cập nhật thông tin" onAction="#updateProfile"/>
            </VBox>
        </Tab>
    </TabPane></center>
</BorderPane>
